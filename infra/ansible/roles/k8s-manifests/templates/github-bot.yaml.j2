# Dedicated workload identity for the GitHub bot.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: github-bot
  namespace: netclode
---
# GitHub Bot Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: github-bot
  namespace: netclode
  labels:
    app: github-bot
spec:
  replicas: 1
  selector:
    matchLabels:
      app: github-bot
  template:
    metadata:
      labels:
        app: github-bot
    spec:
      serviceAccountName: github-bot
      automountServiceAccountToken: false
      containers:
        - name: github-bot
          image: ghcr.io/angristan/netclode-github-bot:latest
          ports:
            - containerPort: 8080
              name: http
          env:
            - name: PORT
              value: "8080"
            - name: CONTROL_PLANE_URL
              value: "http://control-plane-bot.netclode.svc.cluster.local:3003"
            - name: CONTROL_PLANE_TOKEN_PATH
              value: "/var/run/secrets/control-plane-auth/token"
            - name: REDIS_URL
              value: "redis://redis-sessions.netclode.svc.cluster.local:6379"
            - name: GITHUB_APP_ID
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-app-id
            - name: GITHUB_APP_PRIVATE_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-app-private-key
            - name: GITHUB_INSTALLATION_ID
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-installation-id
            - name: GITHUB_WEBHOOK_SECRET
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-webhook-secret
            - name: SDK_TYPE
              value: "claude"
            - name: MODEL
              value: "claude-opus-4-6"
            - name: SESSION_TIMEOUT
              value: "10m"
            - name: MAX_CONCURRENT_GITHUB_SESSIONS
              value: "{{ max_concurrent_github_sessions | default('5') }}"
            # OpenTelemetry export (in-cluster collector)
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector:4318"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "deployment.environment=production"
          volumeMounts:
            - name: control-plane-auth
              mountPath: /var/run/secrets/control-plane-auth
              readOnly: true
          readinessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 3
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 8080
            initialDelaySeconds: 5
            periodSeconds: 20
      volumes:
        - name: control-plane-auth
          projected:
            sources:
              - serviceAccountToken:
                  path: token
                  expirationSeconds: 3600
                  audience: netclode-client
---
# GitHub Bot Service
apiVersion: v1
kind: Service
metadata:
  name: github-bot
  namespace: netclode
  labels:
    app: github-bot
spec:
  type: ClusterIP
  selector:
    app: github-bot
  ports:
    - port: 80
      targetPort: 8080
      name: http
