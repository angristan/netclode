# Control Plane Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: control-plane
  namespace: netclode
  labels:
    app: control-plane
spec:
  replicas: 1
  selector:
    matchLabels:
      app: control-plane
  template:
    metadata:
      labels:
        app: control-plane
    spec:
      serviceAccountName: control-plane
{% if image_pull_secret_name | length > 0 %}
      imagePullSecrets:
        - name: {{ image_pull_secret_name }}
{% endif %}
      containers:
        - name: control-plane
          image: {{ control_plane_image }}
          ports:
            - containerPort: 3000
              name: http
          env:
            - name: PORT
              value: "3000"
            - name: K8S_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: AGENT_IMAGE
              value: "{{ agent_image }}"
            - name: ANTHROPIC_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: anthropic-api-key
                  optional: true
            # GitHub Copilot token for Copilot SDK (optional)
            - name: GITHUB_COPILOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-copilot-token
                  optional: true
            # GitHub App integration (optional)
            - name: GITHUB_APP_ID
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-app-id
                  optional: true
            - name: GITHUB_APP_PRIVATE_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-app-private-key
                  optional: true
            - name: GITHUB_INSTALLATION_ID
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-installation-id
                  optional: true
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: openai-api-key
                  optional: true
            - name: CODEX_OAUTH_ENCRYPTION_KEY_B64
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: codex-oauth-encryption-key-b64
                  optional: true
            - name: MISTRAL_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: mistral-api-key
                  optional: true
            # OpenCode Zen API key (optional - for paid Zen models)
            - name: OPENCODE_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: opencode-api-key
                  optional: true
            # Z.AI API key (optional - for GLM-4.7 models)
            - name: ZAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: zai-api-key
                  optional: true
            # Ollama local inference (optional - only set if ollama_enabled)
{% if ollama_enabled | default(false) %}
            - name: OLLAMA_URL
              value: "http://ollama.netclode.svc.cluster.local:11434"
{% endif %}
            - name: REDIS_URL
              value: "redis://redis-sessions.netclode.svc.cluster.local:6379"
            - name: WARM_POOL_ENABLED
              value: "true"
            - name: MAX_ACTIVE_SESSIONS
              value: "{{ max_active_sessions | default('5') }}"
            # Host resources (used to derive per-session limits: CPU 50%, Memory 25%)
            - name: HOST_CPUS
              value: "{{ ansible_processor_vcpus }}"
            - name: HOST_MEMORY_MB
              value: "{{ ansible_memtotal_mb }}"
            # Overcommit ratios for K8s scheduling (requests = actual / ratio)
            # Higher ratio = more pods can be scheduled. Kata VMs still get full resources.
            - name: CPU_OVERCOMMIT_RATIO
              value: "{{ cpu_overcommit_ratio | default('4') }}"
            - name: MEMORY_OVERCOMMIT_RATIO
              value: "{{ memory_overcommit_ratio | default('4') }}"
          readinessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 15
            periodSeconds: 20
---
# Control Plane Service
apiVersion: v1
kind: Service
metadata:
  name: control-plane
  namespace: netclode
  labels:
    app: control-plane
spec:
  type: ClusterIP
  selector:
    app: control-plane
  ports:
    - port: 80
      targetPort: 3000
      name: http
# Note: iOS clients connect via Tailscale Ingress (see control-plane-ingress.yaml)
# Internal agents connect via h2c on this service (port 80)
