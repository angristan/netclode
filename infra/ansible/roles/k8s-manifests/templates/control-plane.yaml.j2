# Control Plane Deployment
apiVersion: apps/v1
kind: Deployment
metadata:
  name: control-plane
  namespace: netclode
  labels:
    app: control-plane
spec:
  replicas: 1
  selector:
    matchLabels:
      app: control-plane
  template:
    metadata:
      labels:
        app: control-plane
    spec:
      serviceAccountName: control-plane
      containers:
        - name: control-plane
          image: ghcr.io/angristan/netclode-control-plane:latest
          ports:
            - containerPort: 3000
              name: client
            - containerPort: 3001
              name: agent
            - containerPort: 3002
              name: internal
            - containerPort: 3003
              name: bot
          env:
            - name: CLIENT_PORT
              value: "3000"
            - name: AGENT_PORT
              value: "3001"
            - name: INTERNAL_PORT
              value: "3002"
            - name: BOT_PORT
              value: "3003"
            - name: K8S_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: ANTHROPIC_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: anthropic-api-key
            # GitHub Copilot token for Copilot SDK (optional)
            - name: GITHUB_COPILOT_TOKEN
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-copilot-token
                  optional: true
            # GitHub App integration (optional)
            - name: GITHUB_APP_ID
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-app-id
                  optional: true
            - name: GITHUB_APP_PRIVATE_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-app-private-key
                  optional: true
            - name: GITHUB_INSTALLATION_ID
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: github-installation-id
                  optional: true
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: openai-api-key
                  optional: true
            - name: CODEX_ACCESS_TOKEN
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: codex-access-token
                  optional: true
            - name: CODEX_ID_TOKEN
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: codex-id-token
                  optional: true
            - name: CODEX_REFRESH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: codex-refresh-token
                  optional: true
            - name: MISTRAL_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: mistral-api-key
                  optional: true
            # OpenCode Zen API key (optional - for paid Zen models)
            - name: OPENCODE_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: opencode-api-key
                  optional: true
            # Z.AI API key (optional - for GLM-4.7 models)
            - name: ZAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: netclode-secrets
                  key: zai-api-key
                  optional: true
            # Ollama local inference (optional - only set if ollama_enabled)
{% if ollama_enabled | default(false) %}
            - name: OLLAMA_URL
              value: "http://ollama.netclode.svc.cluster.local:11434"
{% endif %}
            - name: REDIS_URL
              value: "redis://redis-sessions.netclode.svc.cluster.local:6379"
            - name: WARM_POOL_ENABLED
              value: "true"
            - name: MAX_ACTIVE_SESSIONS
              value: "{{ max_active_sessions | default('5') }}"
            - name: IDLE_TIMEOUT_MINUTES
              value: "{{ idle_timeout_minutes | default('0') }}"
            # Host resources (used to derive per-session limits: CPU 50%, Memory 25%)
            - name: HOST_CPUS
              value: "{{ ansible_processor_vcpus }}"
            - name: HOST_MEMORY_MB
              value: "{{ ansible_memtotal_mb }}"
            # Overcommit ratios for K8s scheduling (requests = actual / ratio)
            # Higher ratio = more pods can be scheduled. Kata VMs still get full resources.
            - name: CPU_OVERCOMMIT_RATIO
              value: "{{ cpu_overcommit_ratio | default('4') }}"
            - name: MEMORY_OVERCOMMIT_RATIO
              value: "{{ memory_overcommit_ratio | default('4') }}"
            # OpenTelemetry export (in-cluster collector)
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: "http://otel-collector:4318"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "deployment.environment=production"
          readinessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 15
            periodSeconds: 20
---
# Tailscale-only human client service
apiVersion: v1
kind: Service
metadata:
  name: control-plane-client
  namespace: netclode
  labels:
    app: control-plane
spec:
  type: ClusterIP
  selector:
    app: control-plane
  ports:
    - port: 80
      targetPort: 3000
      name: client
---
apiVersion: v1
kind: Service
metadata:
  name: control-plane-agent
  namespace: netclode
spec:
  selector:
    app: control-plane
  ports:
    - port: 3001
      targetPort: 3001
      name: agent
---
apiVersion: v1
kind: Service
metadata:
  name: control-plane-internal
  namespace: netclode
spec:
  selector:
    app: control-plane
  ports:
    - port: 3002
      targetPort: 3002
      name: internal
---
apiVersion: v1
kind: Service
metadata:
  name: control-plane-bot
  namespace: netclode
spec:
  selector:
    app: control-plane
  ports:
    - port: 3003
      targetPort: 3003
      name: bot
---
# Each listener is reachable only from its intended trust domain.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: control-plane-ingress
  namespace: netclode
spec:
  podSelector:
    matchLabels:
      app: control-plane
  policyTypes:
    - Ingress
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: tailscale
      ports:
        - protocol: TCP
          port: 3000
    - from:
        - podSelector:
            matchLabels:
              netclode.io/component: agent
      ports:
        - protocol: TCP
          port: 3001
    - from:
        - podSelector:
            matchLabels:
              app: secret-proxy
      ports:
        - protocol: TCP
          port: 3002
    - from:
        - podSelector:
            matchLabels:
              app: github-bot
      ports:
        - protocol: TCP
          port: 3003
